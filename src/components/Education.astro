---
// Education.astro — Educación y Logros Académicos
export interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<section id="educacion" class="relative py-16 sm:py-20 overflow-hidden">
  <div class="absolute inset-0 grid-overlay opacity-20 pointer-events-none"></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-neon-green/30 to-transparent"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-10">
      <span class="section-label">// academic_status.log</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-text-primary mt-4 mb-2">
        {isEn ? "Education &" : "Educación y"} <span class="text-neon">{isEn ? "Achievements" : "Logros"}</span>
      </h2>
      <p class="text-text-muted text-sm">
        {isEn ? "Core academic background and key certifications." : "Formación académica base y certificaciones destacadas."}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Main Education Node (UDP) -->
      <div class="lg:col-span-2 card-glow p-6 relative overflow-hidden group border-neon-green/30">
        <div class="absolute top-0 right-0 w-32 h-32 bg-neon-green/5 rounded-full -translate-y-8 translate-x-8 group-hover:scale-125 transition-transform duration-500 pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col h-full justify-between">
          <div>
            <div class="flex items-center gap-3 mb-5">
              <div class="ping-dot w-2 h-2" style="background:#00ff88;"></div>
              <span class="font-mono text-neon-green text-sm font-semibold tracking-wider">{isEn ? "MAIN NODE" : "NODO PRINCIPAL"}</span>
            </div>
            
            <h3 class="text-2xl font-bold text-text-primary mb-1">Universidad Diego Portales</h3>
            <div class="font-mono text-electric-blue text-sm mb-4">{isEn ? "Computer Engineering and Telecommunications" : "Ingeniería Civil en Informática y Telecomunicaciones"}</div>
            <div class="text-text-muted text-xs font-mono mb-6">{isEn ? "2024 — Present" : "2024 — Presente"}</div>
          </div>

          <!-- KPI Dashboard Style for GPA -->
          <div class="mt-auto bg-dark-bg/60 border border-dark-border p-4 rounded-xl flex items-center justify-between">
            <div>
              <div class="text-[10px] text-text-muted font-mono uppercase tracking-wider mb-1">{isEn ? "Academic Performance" : "Rendimiento Académico"}</div>
              <div class="text-xs text-text-primary">{isEn ? "Current GPA (Chilean Scale)" : "Promedio Actual (GPA)"}</div>
            </div>
            <div class="flex items-end gap-2">
              <span class="text-3xl font-black text-neon-green font-mono leading-none">6.2</span>
              <span class="text-[10px] text-neon-green/60 font-mono mb-1">/ 7.0</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Certifications / Nodes Column -->
      <div class="lg:col-span-1 flex flex-col gap-6">
        
        <!-- Hackathon Node -->
        <div class="card-glow p-5 flex-1 border-signal-orange/20 hover:border-signal-orange/50 transition-colors">
          <div class="flex items-center justify-between mb-3">
            <div class="w-8 h-8 rounded bg-signal-orange/10 border border-signal-orange/30 flex items-center justify-center text-sm">
              ⏱️
            </div>
            <span class="text-[10px] text-signal-orange font-mono border border-signal-orange/30 px-2 py-0.5 rounded">OCT 2025</span>
          </div>
          <h4 class="font-bold text-text-primary text-sm mb-1">IEEEXtreme 19.0</h4>
          <p class="text-text-muted text-xs leading-relaxed">
            {isEn ? "Participant in the 24-hour global hackathon. Intensive algorithmic problem-solving under extreme pressure." : "Participante en la hackatón global de 24 horas. Resolución intensiva de problemas algorítmicos bajo presión extrema."}
          </p>
        </div>

        <!-- Course Node -->
        <div class="card-glow p-5 flex-1 border-electric-blue/20 hover:border-electric-blue/50 transition-colors">
          <div class="flex items-center justify-between mb-3">
            <div class="w-8 h-8 rounded bg-electric-blue/10 border border-electric-blue/30 flex items-center justify-center text-sm">
              💻
            </div>
            <span class="text-[10px] text-electric-blue font-mono border border-electric-blue/30 px-2 py-0.5 rounded">USM</span>
          </div>
          <h4 class="font-bold text-text-primary text-sm mb-1">{isEn ? "OCILabs Intermediate" : "OCILabs Intermedio"}</h4>
          <p class="text-text-muted text-xs leading-relaxed">
            {isEn ? "Advanced C++ programming and complex data structures. Oriented towards optimization and efficiency." : "Programación avanzada en C++ y estructuras de datos complejas. Orientado a optimización y eficiencia."}
          </p>
        </div>

      </div>
    </div>
  </div>
</section>
