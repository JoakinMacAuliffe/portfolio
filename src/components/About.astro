---
// About.astro — Perfil y Motivaciones (Montañismo y Música)
export interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<section id="sobre-mi" class="relative py-16 sm:py-20 overflow-hidden">
  <div class="absolute inset-0 bg-dark-surface/30 pointer-events-none"></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-electric-blue/30 to-transparent"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-10">
      <span class="section-label">// {isEn ? "diagnostic_profile.sys" : "perfil_diagnostico.sys"}</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-text-primary mt-4 mb-2">
        {isEn ? "About" : "Sobre"} <span class="text-neon-blue">{isEn ? "Me" : "Mí"}</span>
      </h2>
      <p class="text-text-muted text-sm">
        {isEn ? "Correlation between personal interests and engineering approach." : "Correlación entre intereses personales y enfoque ingenieril."}
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Mountaineering Card -->
      <div class="card-glow p-6 relative overflow-hidden group">
        <!-- Abstract Topo Map Background -->
        <div class="absolute inset-0 opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-700 pointer-events-none" style="background-image: repeating-radial-gradient(circle at 0 0, transparent 0, transparent 10px, #00d4ff 10px, #00d4ff 11px);"></div>
        
        <div class="relative z-10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-electric-blue/10 border border-electric-blue/30 flex items-center justify-center text-xl">
              🏔️
            </div>
            <div>
              <h3 class="font-mono text-electric-blue font-semibold">{isEn ? "Mountaineering" : "Montañismo"}</h3>
              <div class="text-xs text-text-muted font-mono mt-0.5">{isEn ? "UDP Mountain Group" : "Grupo de Montaña UDP"}</div>
            </div>
          </div>
          
          <div class="space-y-3 text-sm text-text-muted leading-relaxed">
            <p>
              {isEn ? "My connection with nature and the extreme environments of the Andes was the direct inspiration for focusing on telecommunications." : "Mi conexión con la naturaleza y los entornos extremos de la cordillera fue la inspiración directa para enfocarme en las telecomunicaciones."}
            </p>
            <p class="pl-3 border-l-2 border-electric-blue/40 text-text-primary">
              {isEn ? "Experiencing total disconnection in the field led me to co-design " : "Experimentar la desconexión total en terreno me llevó a co-diseñar "}<span class="text-neon-green font-mono">back2home</span>{isEn ? ", solving real connectivity problems where commercial networks do not exist." : ", resolviendo problemas reales de conectividad donde las redes comerciales no existen."}
            </p>
          </div>
          
          <div class="mt-5 flex gap-2">
            <span class="text-[10px] px-2 py-1 rounded bg-dark-bg border border-dark-border text-electric-blue font-mono">{isEn ? "RESILIENCE" : "RESILIENCIA"}</span>
            <span class="text-[10px] px-2 py-1 rounded bg-dark-bg border border-dark-border text-electric-blue font-mono">{isEn ? "FIELDWORK" : "TERRENO"}</span>
          </div>
        </div>
      </div>

      <!-- Music Card -->
      <div class="card-glow p-6 relative overflow-hidden group">
        <!-- Abstract Soundwave Background -->
        <div class="absolute inset-0 opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-700 pointer-events-none flex flex-col justify-center gap-2">
            <div class="h-px bg-signal-orange w-full transform scale-x-110 origin-left"></div>
            <div class="h-px bg-signal-orange w-3/4 transform scale-x-110 origin-left"></div>
            <div class="h-px bg-signal-orange w-full transform scale-x-110 origin-left"></div>
            <div class="h-px bg-signal-orange w-1/2 transform scale-x-110 origin-left"></div>
        </div>

        <div class="relative z-10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-signal-orange/10 border border-signal-orange/30 flex items-center justify-center text-xl">
              🎸
            </div>
            <div>
              <h3 class="font-mono text-signal-orange font-semibold">{isEn ? "Music" : "Música"}</h3>
              <div class="text-xs text-text-muted font-mono mt-0.5">{isEn ? "Lead Guitarist (UDP CMP)" : "Guitarrista Principal (CMP UDP)"}</div>
            </div>
          </div>
          
          <div class="space-y-3 text-sm text-text-muted leading-relaxed">
            <p>
              {isEn ? "As the lead guitarist in the UDP Popular Music Company, I find the perfect balance between creativity and structure." : "Como guitarrista principal en la Compañía de Música Popular UDP, encuentro el equilibrio perfecto entre creatividad y estructura."}
            </p>
            <p class="pl-3 border-l-2 border-signal-orange/40 text-text-primary">
              {isEn ? "Music has forged in me a strong " : "La música me ha forjado una fuerte "}<span class="text-signal-orange">{isEn ? "discipline" : "disciplina"}</span>{isEn ? " and the ability to solve complex problems by breaking them down into structured patterns, skills I apply daily in software development and network design." : " y la capacidad de resolver problemas complejos dividiéndolos en patrones estructurados, habilidades que aplico diariamente en el desarrollo de software y diseño de redes."}
            </p>
          </div>

          <div class="mt-5 flex gap-2">
            <span class="text-[10px] px-2 py-1 rounded bg-dark-bg border border-dark-border text-signal-orange font-mono">{isEn ? "DISCIPLINE" : "DISCIPLINA"}</span>
            <span class="text-[10px] px-2 py-1 rounded bg-dark-bg border border-dark-border text-signal-orange font-mono">{isEn ? "CREATIVITY" : "CREATIVIDAD"}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
