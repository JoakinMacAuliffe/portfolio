---
// Footer.astro — Footer with contact links
---

<footer class="relative border-t border-dark-border py-12 overflow-hidden">
  <div class="absolute inset-0 grid-overlay opacity-20 pointer-events-none">
  </div>

  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-10">
      <!-- Identity -->
      <div>
        <div class="font-mono text-neon-green font-bold mb-2 text-lg">JM</div>
        <div class="text-text-primary font-semibold mb-1">
          Joakin Mac-Auliffe
        </div>
        <div class="text-text-muted text-sm mb-3">
          Estudiante de Ingeniería Civil en Informática y Telecomunicaciones
        </div>
        <div class="flex items-center gap-2">
          <span class="ping-dot w-2 h-2"></span>
          <span class="terminal-text text-xs">-33.4489° S, -70.6693° W</span>
        </div>
        <div class="terminal-text text-xs mt-1 opacity-60">
          Santiago, Chile · UTC-4
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="terminal-text text-xs mb-4">// navegación</h4>
        <ul class="space-y-2">
          {
            [
              { href: "#hero", label: "inicio" },
              { href: "#back2home", label: "back2home" },
              { href: "#experiencia", label: "experiencia" },
              { href: "#stack", label: "stack técnico" },
            ].map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-text-muted hover:text-neon-green transition-colors duration-200 text-sm font-mono"
                >
                  <span class="text-neon-green/40">/</span>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contacto / Redes -->
      <div>
        <h4 class="terminal-text text-xs mb-4">// contacto</h4>
        <div class="space-y-3">
          <a
            href="https://github.com/JoakinMacAuliffe"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-text-muted hover:text-neon-green transition-colors duration-200 group"
          >
            <svg
              class="w-4 h-4 group-hover:scale-110 transition-transform"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            <span class="text-sm">github.com/JoakinMacAuliffe</span>
          </a>
          <a
            href="https://linkedin.com/in/joakinmacauliffe"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-text-muted hover:text-electric-blue transition-colors duration-200 group"
          >
            <svg
              class="w-4 h-4 group-hover:scale-110 transition-transform"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
            <span class="text-sm">linkedin.com/in/joakinmacauliffe</span>
          </a>
        </div>
      </div>
    </div>

    <div class="divider-glow mb-6"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="terminal-text text-xs opacity-40">
        © 2026 Joakin Fernando Mac-Auliffe López — Todos los derechos reservados
      </p>
      <div class="flex items-center gap-2">
        <span class="ping-dot w-1.5 h-1.5"></span>
        <span class="terminal-text text-xs opacity-40">
          Built with Astro + Framer Motion · Deployed on Vercel
        </span>
      </div>
    </div>
  </div>
</footer>
