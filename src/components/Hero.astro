---
// Hero.astro — Limpio y directo
import NodeCanvas from "./NodeCanvas";

export interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <!-- Grid overlay -->
  <div class="absolute inset-0 grid-overlay opacity-40 pointer-events-none">
  </div>
  <div class="absolute inset-0 bg-hero-gradient pointer-events-none"></div>

  <!-- Canvas background -->
  <div class="absolute inset-0">
    <NodeCanvas client:load />
  </div>

  <!-- Content -->
  <div
    class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 pt-24 sm:pt-28 pb-16 sm:pb-20 flex flex-col lg:flex-row items-center gap-10 sm:gap-16"
  >
    <!-- Avatar -->
    <div class="relative flex-shrink-0">
      <div class="relative w-52 h-52 sm:w-60 sm:h-60 md:w-72 md:h-72 lg:w-80 lg:h-80">
        <div
          class="absolute top-0 left-0 w-4 h-4 sm:w-5 sm:h-5 border-t-2 border-l-2 border-neon-green"
        >
        </div>
        <div
          class="absolute top-0 right-0 w-4 h-4 sm:w-5 sm:h-5 border-t-2 border-r-2 border-neon-green"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 w-4 h-4 sm:w-5 sm:h-5 border-b-2 border-l-2 border-neon-green"
        >
        </div>
        <div
          class="absolute bottom-0 right-0 w-4 h-4 sm:w-5 sm:h-5 border-b-2 border-r-2 border-neon-green"
        >
        </div>
        <div
          class="absolute inset-3 rounded-lg overflow-hidden border border-dark-border"
        >
          <img
            src="/avatar.jpg"
            alt="Joakin Mac-Auliffe"
            class="w-full h-full object-cover"
            style="filter: saturate(0.9) contrast(1.05);"
          />
          <div
            class="absolute inset-0 bg-gradient-to-b from-transparent to-neon-green/10"
          >
          </div>
        </div>
        <div
          class="absolute -bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2 whitespace-nowrap"
        >
          <span class="ping-dot w-2 h-2"></span>
          <span class="terminal-text text-xs opacity-60">RF:ACTIVE</span>
        </div>
      </div>
    </div>

    <!-- Text -->
    <div class="flex-1 text-center lg:text-left mt-4 sm:mt-0">
      <div class="flex flex-wrap gap-2 mb-4 sm:mb-5 justify-center lg:justify-start">
        <span class="badge-neon text-[0.65rem] sm:text-[0.7rem]">Universidad Diego Portales</span>
        <span class="badge-orange text-[0.65rem] sm:text-[0.7rem]">Santiago, Chile</span>
      </div>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-bold text-text-primary mb-2 leading-tight"
      >
        Joakin
        <span class="block text-neon">Mac-Auliffe</span>
      </h1>

      <p class="font-mono text-electric-blue text-xs sm:text-sm mb-4 sm:mb-5 tracking-wide leading-relaxed">
        &gt; {isEn ? "Computer Engineering & Telecommunications Student" : "Estudiante de Ingeniería Civil en Informática y Telecomunicaciones"}
      </p>

      <p
        class="text-text-muted text-sm sm:text-base max-w-md mx-auto lg:mx-0 mb-6 sm:mb-8 leading-relaxed"
      >
        {isEn 
          ? "I design critical infrastructure that connects the disconnected: autonomous mesh networks, embedded IoT systems, and digital transmission." 
          : "Diseño infraestructura crítica que conecta lo desconectado: redes mesh autónomas, sistemas IoT embebidos y transmisión digital."}
      </p>

      <div class="flex flex-wrap gap-2 sm:gap-3 justify-center lg:justify-start">
        <a
          href={isEn ? "/en/#back2home" : "#back2home"}
          class="flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 bg-neon-green text-dark-bg font-semibold rounded-lg hover:bg-neon-green/90 transition-all duration-300 text-xs sm:text-sm"
        >
          {isEn ? "View Flagship Project" : "Ver Proyecto Estrella"}
        </a>
        <a
          href="https://linkedin.com/in/joakinmacauliffe"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 border border-electric-blue/40 text-electric-blue rounded-lg hover:bg-electric-blue/10 transition-all duration-300 text-xs sm:text-sm"
        >
          LinkedIn
        </a>
        <a
          href="mailto:jfmacauliffe@gmail.com"
          class="flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 border border-dark-border text-text-muted rounded-lg hover:border-text-primary hover:text-text-primary transition-all duration-300 text-xs sm:text-sm"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          Email
        </a>
        <a
          href="https://github.com/JoakinMacAuliffe"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 border border-dark-border text-text-muted rounded-lg hover:border-neon-green/40 hover:text-neon-green transition-all duration-300 text-xs sm:text-sm"
        >
          GitHub
        </a>
        <a
          href={isEn ? "/en/cv" : "/cv"}
          class="flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 border border-signal-orange/40 text-signal-orange rounded-lg hover:bg-signal-orange/10 transition-all duration-300 text-xs sm:text-sm"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          CV
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-30"
  >
    <div
      class="w-px h-10 bg-gradient-to-b from-neon-green to-transparent animate-bounce"
    >
    </div>
  </div>
</section>
