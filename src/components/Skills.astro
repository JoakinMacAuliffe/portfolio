---
// Skills.astro — Stack limpio
import SkillCards from './SkillCards';

export interface Props {
  lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<section id="stack" class="relative py-16 sm:py-20 overflow-hidden">
  <div class="absolute inset-0 grid-overlay opacity-20 pointer-events-none"></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-signal-orange/30 to-transparent"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div class="mb-8">
      <span class="section-label">// technical_stack.json</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-text-primary mt-4 mb-2">
        {isEn ? "Technical" : "Stack"} <span class="text-neon-orange">{isEn ? "Stack" : "Técnico"}</span>
      </h2>
      <p class="text-text-muted text-sm">
        RF & Wireless · {isEn ? "Embedded Hardware" : "Hardware embebido"} · Software & Cloud
      </p>
    </div>

    <div class="divider-glow mb-10"></div>

    <!-- Skill Cards -->
    <SkillCards lang={lang} client:load />

  </div>
</section>
