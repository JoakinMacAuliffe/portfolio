---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  title?: string;
  description?: string;
  lang?: "es" | "en";
}

const {
  title = "Joakin Mac-Auliffe | Portafolio",
  description = "Portafolio profesional de Joakin Fernando Mac-Auliffe López, estudiante de Ingeniería Civil en Informática y Telecomunicaciones UDP. Especialista en redes inalámbricas, IoT, LoRa Mesh, sistemas embebidos y transmisión digital.",
  lang = "es"
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Joakin Fernando Mac-Auliffe López" />
    <meta
      name="keywords"
      content="telecomunicaciones, IoT, LoRa, ESP32, redes inalámbricas, ingeniero, UDP, Chile, back2home"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-dark-bg text-text-primary antialiased">
    <slot />
    <Analytics />
  </body>
</html>
